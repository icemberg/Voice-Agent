# ================================================================
# Kapture Mock Server — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ================================================================

# ---- BUILD-TIME ARGS (injected into index.html during docker build) ----
# Your Vapi public API key (starts with pk_)
VAPI_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPI_PUBLIC_KEY

# Your Vapi inbound assistant ID (starts with ast_)
ASSISTANT_ID=REPLACE_WITH_YOUR_INBOUND_ASSISTANT_ID

# ---- RUNTIME SECRETS (injected at container start) ----
# Vapi webhook shared secret — set in your Vapi dashboard under
# Server URL > Advanced > Secret. Leave blank to skip auth.
VAPI_SHARED_SECRET=

# Port the server listens on (default: 3000)
PORT=3000